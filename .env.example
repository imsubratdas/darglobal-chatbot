# Required in production: use a long random value and keep it private.
SECRET_KEY=replace-with-a-long-random-secret
# Set true when serving the app over HTTPS.
COOKIE_SECURE=false
# Optional persistent storage root; defaults to ./data.
DATA_DIR=./data
# Optional path to a privately migrated SQLite database on the persistent volume.
LEGACY_DATABASE_FILE=
# Optional OpenRouter chat completion key.
OPENROUTER_API_KEY=
# Optional comma-separated model IDs. Default: openrouter/free
OPENROUTER_MODELS=openrouter/free
# Set true to use only an already-downloaded model; local LSA vectors remain available offline.
FASTEMBED_LOCAL_ONLY=false
# External lookup runs only when internal retrieval is insufficient.
ENABLE_EXTERNAL_SEARCH=true
# Tavily is recommended; SerpAPI is an alternative.
TAVILY_API_KEY=
SERPAPI_API_KEY=
